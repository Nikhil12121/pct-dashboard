# Thoughtspot Configuration
# Get these from your manager or Thoughtspot admin

# Thoughtspot instance URL (e.g., https://your-company.thoughtspot.cloud)
THOUGHTSPOT_HOST=https://your-instance.thoughtspot.cloud

# Thoughtspot credentials
THOUGHTSPOT_USERNAME=your_username
THOUGHTSPOT_PASSWORD=your_password

# Optional: Specific Saved Answer IDs
THOUGHTSPOT_INCIDENTS_ANSWER_ID=your-answer-id-here

# API Configuration
API_PORT=8000
